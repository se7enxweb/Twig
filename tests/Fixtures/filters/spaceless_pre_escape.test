--TEST--
"spaceless" filter pre-escapes its input under autoescape
--TEMPLATE--
{% autoescape 'html' %}
1. {{ payload|spaceless }}

2. {{ payload|escape|spaceless }}

3. {{ payload|raw|spaceless }}

4. {% apply spaceless %}<b>   {{ payload }}   </b>   <i>x</i>{% endapply %}
{% endautoescape %}
--DATA--
return ['payload' => '<script>   alert(1)   </script>']
--EXPECT--
1. &lt;script&gt;   alert(1)   &lt;/script&gt;

2. &lt;script&gt;   alert(1)   &lt;/script&gt;

3. <script>   alert(1)   </script>

4. <b>   &lt;script&gt;   alert(1)   &lt;/script&gt;   </b><i>x</i>
